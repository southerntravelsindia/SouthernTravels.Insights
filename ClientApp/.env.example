# Copy to .env.local (development) or .env.production.local (build machine); those files are git-ignored.
# STPLCostSheetAPI root the browser calls, ending in "/" (the part before /api/). In development use /stpl-api/ with the proxy below.
VITE_API_BASE_URL=__SET_ON_SERVER__
# Path the site is served under (e.g. /insights-ins01/); "/" when it has its own host name.
VITE_BASE_PATH=/
# Development only: the API root (scheme, host and any site path, without /api) the dev server forwards /stpl-api/ to.
STPL_API_PROXY_TARGET=__SET_ON_SERVER__
# Development only: certificate file (.pem or .cer) to trust when the API uses a self-signed certificate; keep it outside the repo.
STPL_API_CA_FILE=
# Optional: root of the Insights site that hosts the other 14 reports (side menu links), ending in "/". Leave empty to show them disabled.
VITE_INSIGHTS_URL=
